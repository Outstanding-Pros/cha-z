# 복사해서 .env 로 저장 후 값 입력 (.env 는 커밋하지 않음)
BIZROUTER_API_KEY=sk-br-v1-여기에_키
BIZROUTER_BASE_URL=https://bizrouter.ai/api/v1

# mock  : API 호출 없이 그라데이션 배경으로 파이프라인 테스트
# images: OpenAI 호환 POST /images/generations
# chat  : POST /chat/completions + modalities=["image","text"] (이미지 출력 지원 모델용)
IMAGE_PROVIDER=mock
IMAGE_MODEL=openai/gpt-image-1
IMAGE_SIZE=1024x1536
# gpt-image 계열 품질: low | medium | high (비우면 모델 기본값)
IMAGE_QUALITY=low

# API 호출 타임아웃(초)
IMAGE_TIMEOUT=180

# 서버 음성 처리 (Pleos TTS/STT SDK 공개 전 대체)
TTS_MODEL=openai/gpt-4o-mini-tts
TTS_VOICE=nova
STT_MODEL=openai/gpt-transcribe
# 음성 명령 LLM 폴백 (규칙 파서 실패 시). 실측 ~1.1초
TEXT_MODEL=google/gemini-3.1-flash-lite
