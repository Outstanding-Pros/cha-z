# 복사해서 .env 로 저장 후 값 입력 (.env 는 커밋하지 않음)
BIZROUTER_API_KEY=sk-br-v1-여기에_키
BIZROUTER_BASE_URL=https://bizrouter.ai/api/v1

# mock  : API 호출 없이 그라데이션 배경으로 파이프라인 테스트
# images: OpenAI 호환 POST /images/generations
# chat  : POST /chat/completions + modalities=["image","text"] (이미지 출력 지원 모델용)
IMAGE_PROVIDER=mock
IMAGE_MODEL=openai/gpt-image-1
IMAGE_SIZE=1024x1536
# gpt-image 계열 품질: low | medium | high (비우면 모델 기본값)
IMAGE_QUALITY=low

# API 호출 타임아웃(초)
IMAGE_TIMEOUT=180

# 서버 음성 처리 (Pleos TTS/STT SDK 공개 전 대체)
TTS_MODEL=openai/gpt-4o-mini-tts
TTS_VOICE=nova
STT_MODEL=openai/gpt-transcribe
# 음성 명령 LLM 폴백 (규칙 파서 실패 시). 실측 ~1.1초
TEXT_MODEL=google/gemini-3.1-flash-lite
# 폰이 접속할 서버 주소 (QR·공유 링크에 들어감). 외부 공개 시 https://<서버 도메인>. 비우면 자동(이 PC 의 LAN IP). 예: http://192.168.0.10:8787
PUBLIC_BASE_URL=
# 서명 URL 비밀값. 비우면 data/sync/secret 에 자동 생성
SYNC_SECRET=

# ✨ AI 오픈카 (/frames/opentop) — 비즈라우터 chat/completions 이미지 편집 모델
OPENTOP_MODEL=
# 음성 명령 LLM 폴백 타임아웃(초)
TEXT_TIMEOUT=
# TTS 말투 지시 (선택)
TTS_INSTRUCTIONS=
# 프레임 생성용 글꼴 경로 (선택)
FRAME_FONT=

# 포트 (기본 8787) · 폰 카메라용 HTTPS 포트 (자체 서명, 기본 8788)
PORT=
CHAZ_HTTPS_PORT=

# 외부 공개(터널) 시 보호 — server/app/guard.py
# 차량 앱 전용 경로에 필요한 토큰 (car-app/local.properties 의 CHAZ_APP_TOKEN 과 같은 값)
CHAZ_APP_TOKEN=
# 분당 요청 수(전체 / AI), 하루 AI 호출 수, 하루 이미지 생성 수
CHAZ_RATE_PER_MIN=
CHAZ_AI_PER_MIN=
CHAZ_DAILY_AI_LIMIT=
CHAZ_DAILY_IMAGE_LIMIT=
